{
  "appId": "com.bauhly.app",
  "appName": "Bauhly",
  "webDir": "dist-mobile",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#ffffff"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#ffffff"
    },
    "Keyboard": {
