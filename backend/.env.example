PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/widesignals
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Admin seed (npm run seed:admin) - creates or promotes an admin account.
# Admins can connect more than one Instagram handle.
ADMIN_EMAIL=admin@widesignals.com
ADMIN_PASSWORD=admin-password-1234
ADMIN_NAME=Admin

# Test user seed (npm run seed:test) — for Postman / API debugging.
TEST_EMAIL=test@bauhly.com
TEST_PASSWORD=test-password-1234
TEST_NAME=Test User

# Apify (Instagram scraping) - https://console.apify.com/account/integrations
APIFY_TOKEN=
APIFY_INSTAGRAM_PROFILE_ACTOR=apify/instagram-profile-scraper
APIFY_INSTAGRAM_POST_ACTOR=apify/instagram-post-scraper
INSTAGRAM_POSTS_LIMIT=12
# Posts pulled per competitor for the 30-day analysis scrape (then filtered to 30 days).
COMPETITOR_ANALYSIS_POSTS=40

# Anthropic (brand DNA analysis + competitor discovery) - https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional overrides for the Your plans cost estimate (USD per million tokens).
# Defaults: Sonnet $3 / $15, Haiku $0.80 / $4, Opus $15 / $75.
# ANTHROPIC_INPUT_USD_PER_MTOK=3
# ANTHROPIC_OUTPUT_USD_PER_MTOK=15
# Weekly plan generation output ceiling (7-day JSON). Retries once at RETRY if truncated.
# WEEKLY_PLAN_MAX_TOKENS=32000
# WEEKLY_PLAN_MAX_TOKENS_RETRY=64000
# Multi-agent weekly plan (Strategist → Calendar → 7 Day writers). Default ON.
# Set PLAN_MULTI_AGENT=0 to fall back to the single-prompt path.
# PLAN_MULTI_AGENT=1
# PLAN_AGENT_MODEL=claude-sonnet-5
# PLAN_DAY_MODEL=claude-sonnet-5
# PLAN_STRATEGIST_MAX_TOKENS=4096
# PLAN_CALENDAR_MAX_TOKENS=8192
# PLAN_DAY_MAX_TOKENS=8192

# Competitor discovery model. It only picks hashtags and ranks the real accounts
# found by the hashtag search — it never invents handles — so a cheaper model is
# fine. COMPETITOR_PROVIDER selects the SDK: 'openai' (default) or 'anthropic'.
# Set COMPETITOR_MODEL to the exact provider model id.
COMPETITOR_PROVIDER=openai
COMPETITOR_MODEL=gpt-5.6-terra

# OpenAI (competitor discovery when COMPETITOR_PROVIDER=openai) - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Meta Instagram Content Publishing — Connect with Meta + optional live publish
# https://developers.facebook.com/docs/instagram-platform/instagram-api-with-facebook-login
META_APP_ID=
META_APP_SECRET=
# Must match a Valid OAuth Redirect URI (e.g. http://localhost:5173/dashboard/meta/callback)
META_REDIRECT_URI=
# Facebook Login *for Business* only: the Configuration ID that bundles the
# Instagram permissions (Facebook Login for Business → Configurations). When set,
# the OAuth dialog uses config_id instead of requesting scopes directly. Leave
# blank for classic Facebook Login (scope-based).
META_LOGIN_CONFIG_ID=1718204732823338
# Optional override of the requested OAuth scopes (comma-separated). Leave blank
# for the default set (includes instagram_manage_insights so connected accounts
# can refresh profile/media/insights via Graph instead of Apify). Temporarily
# drop a not-yet-approved permission here so connecting works during setup, e.g.:
#   META_SCOPES=instagram_basic,pages_show_list,pages_read_engagement,business_management
META_SCOPES=
# Set to 1 only when slide images are public HTTPS URLs Graph can fetch
META_PUBLISH_LIVE=0

# AWS S3 (brand analysis reports + project media)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REPORT_PRESIGN_EXPIRY_SECONDS=3600
# Expiry for project media upload/read presigned URLs.
S3_PRESIGN_EXPIRY_SECONDS=3600
# Project media is uploaded browser→S3 with presigned PUT URLs, so the bucket
# must allow the app origin to PUT. Add a CORS rule like:
#   [{ "AllowedOrigins": ["http://localhost:5173"], "AllowedMethods": ["PUT","GET"],
#     "AllowedHeaders": ["*"], "MaxAgeSeconds": 3000 }]
# Objects are stored under the private prefix  projects/<userId>/  and are only
# ever reachable through the short-lived presigned GET URLs the API returns.

# ── CDN (CloudFront) for project media ───────────────────────────────────────
# Optional. When set, project media (Projects page images/videos) is served from
# this stable, cacheable base URL instead of rotating presigned S3 URLs — a
# CloudFront distribution in front of the bucket, e.g. https://d111abcdef8.cloudfront.net
# (or a custom domain like https://cdn.yourdomain.com).
# The API returns  <MEDIA_CDN_BASE_URL>/<object-key>  so CloudFront + the browser
# cache each asset long-term (objects use immutable, content-addressed keys).
# Leave blank to keep the presigned-URL behaviour. Full setup (distribution, OAC,
# bucket policy) steps: backend/aws/CLOUDFRONT_CDN.md
MEDIA_CDN_BASE_URL=

# ── Image generation (WeekView "Create image" — Gemini "nano banana") ────────
# Model id; override only to pin a specific version.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Option A — Gemini Developer API (simplest): set an API key.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Option B — Vertex AI: flip this on and provide a GCP project + location.
# Auth uses Application Default Credentials (set GOOGLE_APPLICATION_CREDENTIALS
# to a service-account key file, or use workload identity).
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
