          "name": "Get Authority Funnel",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instagram/authority?username={{username}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instagram", "authority"],
              "query": [{ "key": "username", "value": "{{username}}" }]
            }
          }
        },
        {
          "name": "Get Analysis Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instagram/analysis-overview?username={{username}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "instagram", "analysis-overview"],
              "query": [{ "key": "username", "value": "{{username}}" }]
            }
          }
        }
      ]
    },
