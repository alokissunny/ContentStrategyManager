            "url": {
              "raw": "{{baseUrl}}/api/meta/publish/{{routeId}}/day/0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "meta", "publish", "{{routeId}}", "day", "0"]
            }
          }
        }
      ]
    }
  ]
}
