{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow", "Action": ["sts:GetCallerIdentity", "cloudformation:ValidateTemplate", "cloudformation:Describe*", "cloudformation:List*", "lambda:*EventSourceMapping*", "lambda:TagResource", "logs:*", "cloudwatch:*Alarm*", "cloudwatch:GetMetricStatistics"], "Resource": "*" },
    { "Effect": "Allow", "Action": "cloudformation:*", "Resource": "arn:aws:cloudformation:*:*:stack/bauhly-reel-worker/*" },
    { "Effect": "Allow", "Action": ["s3:CreateBucket", "s3:ListBucket", "s3:GetObject", "s3:PutObject", "s3:GetBucketLocation"], "Resource": ["arn:aws:s3:::bauhly-reel-worker-code-*", "arn:aws:s3:::bauhly-reel-worker-code-*/*"] },
    { "Effect": "Allow", "Action": "sqs:*", "Resource": "arn:aws:sqs:*:*:capture-reels*" },
    { "Effect": "Allow", "Action": "lambda:*", "Resource": "arn:aws:lambda:*:*:function:bauhly-reel-worker*" },
    { "Effect": "Allow", "Action": ["iam:*Role*", "iam:PassRole"], "Resource": "arn:aws:iam::*:role/bauhly-reel-worker" },
    { "Effect": "Allow", "Action": ["iam:*User", "iam:*UserPolicy", "iam:ListUserPolicies", "iam:TagUser", "iam:ListAccessKeys"], "Resource": "arn:aws:iam::*:user/bauhly-reel-queue-sender" }
  ]
}
